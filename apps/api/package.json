{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:up": "NODE_OPTIONS=\"--import tsx\" knex migrate:latest --knexfile knexfile.ts",
    "migrate:down": "NODE_OPTIONS=\"--import tsx\" knex migrate:rollback --all --knexfile knexfile.ts"
  },
  "dependencies": {
    "@fastify/helmet": "~13.0.0",
    "@fastify/rate-limit": "~10.2.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@repo/shared": "*",
    "fastify": "^5.10.0",
    "ioredis": "~5.4.0",
    "jose": "~5.9.0",
    "knex": "~3.1.0",
    "pg": "~8.13.0",
    "uuidv7": "~1.0.2",
    "vite": "8.1.4"
  },
  "devDependencies": {
    "@types/node": "~26.0.0",
    "@types/pg": "~8.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "~4.19.0",
    "typescript": "~5.6.0",
    "vitest": "^4.1.10"
  }
}
