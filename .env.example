# Local dev environment for the compose stack.
#   cp .env.example .env   # then fill in the OAuth placeholders
# `.env` is gitignored (see .gitignore lines 2-3). NEVER commit real secrets.
# These are LOCAL-DEV values only — production secrets live in AWS Secrets Manager.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Compose reads these to configure the postgres/redis services. They MUST match
# the credentials embedded in the URLs below — change both places together.
POSTGRES_PASSWORD=localdev
REDIS_PASSWORD=localdev

# ── Datastores (host = compose service name, resolved over the bridge net) ─────
DATABASE_URL=postgres://postgres:localdev@postgres:5432/teamtodo
REDIS_URL=redis://:localdev@redis:6379

# ── OAuth2 (Google) — public values, plain config (not secrets) ────────────────
OAUTH_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback
# Optional overrides (config.ts has sane defaults):
# OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# OAUTH_SCOPES=openid email profile

# ── Secrets ────────────────────────────────────────────────────────────────────
# HEADS UP (see handoff): config.ts currently REQUIRES *_ARN references and
# rejects any *_ARN value that does not start with `arn:aws:`. To BOOT the stack
# today, keep the ARN-shaped placeholders below — the app starts fine because the
# client secret is only resolved LAZILY during an OAuth token exchange (login),
# not at startup.
OAUTH_CLIENT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:local-dev-oauth-client-secret
SESSION_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:local-dev-session-secret

# Local login WITHOUT AWS: these PLAIN values are read directly ONLY when
# NODE_ENV=development (dev resolver in apps/api/src/platform/secrets.ts; the
# *_ARN shape check in config.ts is relaxed for development). In every other
# environment the secret is resolved from AWS Secrets Manager by ARN and these
# vars are ignored. DO NOT put real secrets here — this file is committed.
OAUTH_CLIENT_SECRET=<your-google-oauth-client-secret>
SESSION_SECRET=<random-32+-char-string-for-local-dev>

# ── Session cookie (http on localhost → secure MUST be false locally) ──────────
SESSION_COOKIE_SECURE=false

# ── Feature flags (comma-separated allowlist; empty = all features dark) ───────
FEATURE_FLAGS=team_todo_mvp

# ── Post-login redirect allowlist (open-redirect guard) ────────────────────────
RETURN_TO_ALLOWLIST=/

# ── Trusted proxy (Fastify trustProxy → correct req.ip for F8 rate limiting) ────
# A bare integer = number of proxy hops to trust: '1' trusts one hop (the ALB in
# front of EC2). In production set this to your ALB VPC CIDR instead (e.g.
# 10.0.0.0/8) so req.ip is the real client, not the load balancer.
# Local dev (Rancher Desktop / compose) has no proxy layer, so leave it unset or
# at '1' — either resolves to trusting one hop and behaves correctly locally.
TRUSTED_PROXY_CIDR=1
